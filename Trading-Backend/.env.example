# =========================================================================
# ATIRATH TRADING BACKEND - SMTP & ENVIRONMENT CONFIGURATION
# =========================================================================

# Database Configuration (Defaults to in-memory H2 in dev, or PostgreSQL)
# DB_URL=jdbc:postgresql://localhost:5432/atirath_trading_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_db_password

# Frontend Web Application URL (used in email password reset links)
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------------------
# Real-Time Email SMTP Gateway Configuration (Gmail / SendGrid / SES / etc.)
# -------------------------------------------------------------------------
# For Gmail:
# 1. Turn on 2-Step Verification in your Google Account.
# 2. Go to: Security -> App Passwords -> Create new "Atirath Trading" password.
# 3. Paste the 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

