{
  "family": "atirath-trading-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "trading-backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/atirath-trading-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "postgres"
        },
        {
          "name": "DB_URL",
          "value": "jdbc:postgresql://<RDS_ENDPOINT>:5432/atirath_trading_db"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "value": "<ELASTICACHE_REDIS_ENDPOINT>"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/atirath-trading-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
